# --- Database (Neon) -------------------------------------------------
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# --- Email (Resend) --------------------------------------------------
RESEND_API_KEY="re_..."
SENDER_EMAIL="invites@yourdomain.com"
# Fallbacks only. Each event can override the name, address, and notification
# address in the dashboard under "Who it comes from".
SENDER_NAME="Maya & Daniel"
REPLY_TO_EMAIL="you@yourdomain.com"

# --- App -------------------------------------------------------------
# No trailing slash. Used server-side to build links inside emails.
SITE_URL="https://invite.yourdomain.com"

# Password you type at /admin
ADMIN_PASSWORD="pick-something-long"
# Random string. Signs the admin cookie. openssl rand -hex 32
ADMIN_SECRET="..."

# Random string. Vercel sends this to the cron route. openssl rand -hex 32
CRON_SECRET="..."

# --- Image uploads (Vercel Blob) -------------------------------------
# Vercel sets this automatically once you create a Blob store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
